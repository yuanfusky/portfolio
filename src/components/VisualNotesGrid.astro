---
import { visualWorks } from '../data/visualWorks';
---

<div class="visual-work-grid">
  {visualWorks.map((work, index) => (
    <a
      class="visual-work group"
      href={work.href}
      target="_blank"
      rel="noreferrer"
      aria-label={`Watch ${work.titleEn} — ${work.role}`}
    >
      <div class="poster-frame">
        <img
          src={work.image}
          alt={`${work.titleZh} (${work.titleEn}) documentary poster`}
          loading="lazy"
          width="1080"
          height="1620"
        />
        <span class="work-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="view-label" aria-hidden="true">View work ↗</span>
      </div>

      <div class="work-caption">
        <p class="platform">{work.platform}</p>
        <h3><span lang="zh-CN">《{work.titleZh}》</span> / {work.titleEn}</h3>
        <p class="role">{work.role}</p>
      </div>
    </a>
  ))}
</div>

<style>
  .visual-work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 20rem);
    margin-inline: auto;
    gap: 2rem .75rem;
  }

  .visual-work {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .poster-frame {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    box-shadow: 0 0 0 0 var(--color-accent);
    transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease;
  }

  .poster-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(.2,.75,.25,1), filter 260ms ease;
  }

  .work-index,
  .view-label {
    position: absolute;
    z-index: 1;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: .68rem;
    letter-spacing: .08em;
  }

  .work-index {
    top: .75rem;
    left: .75rem;
    padding: .42rem .5rem;
  }

  .view-label {
    right: .75rem;
    bottom: .75rem;
    padding: .55rem .65rem;
    opacity: 0;
    transform: translateY(.5rem);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .work-caption {
    padding-top: 1rem;
    border-top: 1px solid transparent;
  }

  .platform,
  .role {
    color: var(--color-muted);
    font-size: .72rem;
    line-height: 1.5;
  }

  .platform {
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  h3 {
    margin-top: .55rem;
    font-size: clamp(.92rem, 1.35vw, 1.08rem);
    font-weight: 560;
    line-height: 1.55;
    letter-spacing: -.025em;
  }

  .role {
    margin-top: .35rem;
  }

  .visual-work:hover .poster-frame,
  .visual-work:focus-visible .poster-frame {
    border-color: var(--color-accent);
    box-shadow: .48rem .48rem 0 var(--color-accent);
    transform: translate(-.2rem, -.2rem);
  }

  .visual-work:hover img,
  .visual-work:focus-visible img {
    transform: scale(1.025);
    filter: saturate(1.04) contrast(1.02);
  }

  .visual-work:hover .view-label,
  .visual-work:focus-visible .view-label {
    opacity: 1;
    transform: translateY(0);
  }

  @media (min-width: 740px) {
    .visual-work-grid {
      width: 100%;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(2rem, 4vw, 4.25rem) clamp(1rem, 2.4vw, 2rem);
    }
  }

  @media (max-width: 739px) {
    .work-index {
      top: .5rem;
      left: .5rem;
      padding: .32rem .4rem;
      font-size: .58rem;
    }

    .view-label {
      right: .5rem;
      bottom: .5rem;
      padding: .42rem .5rem;
      font-size: .58rem;
    }

    .work-caption {
      padding-top: .65rem;
    }

    .platform,
    .role {
      font-size: .6rem;
    }

    h3 {
      margin-top: .35rem;
      font-size: .7rem;
      line-height: 1.45;
    }

    .role {
      margin-top: .25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-frame,
    .poster-frame img,
    .view-label {
      transition: none;
    }
  }
</style>
