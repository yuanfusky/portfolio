---
const notes = [
  ['Field / 01', 'Observation'],
  ['Frame / 02', 'Structure'],
  ['Sequence / 03', 'Rhythm'],
  ['Archive / 04', 'Context'],
  ['Trace / 05', 'Pattern'],
  ['Edit / 06', 'Clarity'],
];
---

<div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
  {notes.map(([label, theme], index) => (
    <div class:list={['group relative aspect-[3/4] overflow-hidden rounded-2xl border border-line bg-surface shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-[0_15px_30px_rgba(67,58,50,.09)]', `visual-${index + 1}`]}>
      <div class="absolute inset-0 opacity-65 transition duration-500 group-hover:scale-105 group-hover:opacity-100"></div>
      <div class="absolute inset-x-3 bottom-3 rounded-xl bg-paper/85 p-2.5 backdrop-blur-[3px]">
        <p class="font-mono text-[0.55rem] uppercase tracking-[0.12em] text-ink/60">{label}</p>
        <p class="mt-1 text-xs font-medium">{theme}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .visual-1 > div:first-child { background: linear-gradient(145deg, transparent 46%, #4d4d4d 46.5% 48%, transparent 48.5%), linear-gradient(25deg, #e8dfd7 31%, #fffaf5 31.5%); }
  .visual-2 > div:first-child { background: repeating-linear-gradient(90deg, transparent 0 13px, rgba(62,62,66,.18) 13px 14px), linear-gradient(#fffaf5, #eae1da); }
  .visual-3 > div:first-child { background: radial-gradient(circle at 38% 38%, #2447f2 0 7%, transparent 7.5%), radial-gradient(circle at 65% 56%, #23251f 0 3%, transparent 3.5%), #e2ddcf; }
  .visual-4 > div:first-child { background: linear-gradient(120deg, transparent 0 34%, #4a4b47 35% 46%, transparent 47%), repeating-linear-gradient(0deg, #fffaf5 0 20px, #ded5ce 20px 21px); }
  .visual-5 > div:first-child { background: radial-gradient(ellipse at 50% 30%, transparent 0 25%, rgba(23,25,21,.45) 26% 27%, transparent 28% 37%, rgba(23,25,21,.32) 38% 39%, transparent 40%), #e7e1d3; }
  .visual-6 > div:first-child { background: linear-gradient(160deg, #eee5de 0 49%, #2447f2 50% 59%, #ddd2ca 60%); }
</style>
