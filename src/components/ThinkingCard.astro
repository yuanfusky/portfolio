---
interface Props { title: string; text: string; index: string; }
const { title, text, index } = Astro.props;
---

<article class="group rounded-2xl border border-line bg-surface/55 p-6 transition duration-300 hover:-translate-y-1 hover:border-ink/20 hover:shadow-[0_14px_34px_rgba(52,54,56,.09)]">
  <p class="inline-flex bg-accent px-1.5 py-0.5 font-mono text-[0.56rem] text-ink">{index} / method</p>
  <h3 class="mt-9 font-mono text-base font-semibold tracking-[-0.035em] decoration-accent decoration-4 underline-offset-4 transition group-hover:underline">{title}</h3>
  <p class="mt-4 font-mono text-xs leading-6 text-muted">{text}</p>
</article>
