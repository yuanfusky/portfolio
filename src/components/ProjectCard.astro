---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const { data } = project;
---

<article class="project-row group">
  <a class="project-hit" href={`/projects/${data.slug}/`} aria-label={`Read ${data.title}`}></a>
  <div class:list={['project-stamp', `stamp-${(index % 4) + 1}`]} aria-hidden="true">
    <span>{data.projectCode}</span>
    <small>{String(index + 1).padStart(2, '0')}</small>
  </div>

  <div class="project-copy">
    <div class="mb-3 flex flex-wrap gap-2">
      <Tag label={data.status} />
      <Tag label={data.domain} />
    </div>
    <h3>{data.shortTitle}</h3>
    <div class="project-story">
      <div>
        <span>01 / Problem</span>
        <p>{data.problemSummary}</p>
      </div>
      <div>
        <span>02 / Methods & outcome</span>
        <p>{data.methodsOutcome}</p>
      </div>
    </div>
    <div class="project-tech">{data.methods.slice(0, 3).join(' · ')} <span>/</span> {data.tools.join(' · ')}</div>
  </div>

  <div class="project-side">
    {data.highlightValue ? (
      <div class="project-highlight">
        <strong>{data.highlightValue}</strong>
        <span>{data.highlightLabel}</span>
      </div>
    ) : <span></span>}
    <span class="project-open">open study ↗</span>
  </div>
</article>

<style>
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: 5.75rem minmax(0, 1fr) 8.5rem;
    gap: 1.35rem;
    align-items: center;
    min-height: 12rem;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 1.15rem;
    background: rgba(252,247,242,.68);
    transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
  }
  .project-row:hover {
    z-index: 2;
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-accent) 28%, var(--color-line));
    box-shadow: 0 16px 36px rgba(67,58,50,.09);
  }
  .project-hit { position: absolute; inset: 0; z-index: 10; border-radius: inherit; }
  .project-stamp {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border-radius: .85rem;
    color: white;
    font-family: var(--font-mono);
  }
  .project-stamp::before,
  .project-stamp::after { position: absolute; content: ""; transition: transform .4s ease; }
  .project-stamp::before { width: 4rem; height: 4rem; border: 1px solid rgba(255,255,255,.7); border-radius: 50%; }
  .project-stamp::after { width: 1px; height: 120%; background: rgba(255,255,255,.55); transform: rotate(32deg); }
  .project-row:hover .project-stamp::before { transform: scale(1.16); }
  .project-row:hover .project-stamp::after { transform: rotate(48deg); }
  .project-stamp span { position: relative; z-index: 1; max-width: 4.4rem; padding-inline: .25rem; font-size: .68rem; font-weight: 600; letter-spacing: .06em; text-align: center; }
  .project-stamp small { position: absolute; right: .5rem; bottom: .4rem; z-index: 1; font-size: .45rem; opacity: .72; }
  .stamp-1 { background: #2447f2; }
  .stamp-2 { background: linear-gradient(145deg, #ff906d, #f15e43); }
  .stamp-3 { background: linear-gradient(145deg, #679f91, #3f6c62); }
  .stamp-4 { background: linear-gradient(145deg, #9c8fc8, #66558f); }
  .project-copy h3 { color: var(--color-ink); font-size: clamp(1rem, 1.5vw, 1.18rem); font-weight: 600; letter-spacing: -.035em; }
  .project-story { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.5rem; max-width: 52rem; margin-top: .9rem; }
  .project-story > div { border-top: 1px solid var(--color-line); padding-top: .65rem; }
  .project-story span { color: var(--color-accent); font-size: .56rem; letter-spacing: .08em; text-transform: uppercase; }
  .project-story p { margin-top: .35rem; color: var(--color-muted); font-size: .68rem; line-height: 1.7; }
  .project-tech { margin-top: .8rem; color: #96908a; font-size: .52rem; line-height: 1.6; }
  .project-tech span { color: var(--color-accent); }
  .project-side { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; padding: .3rem; text-align: right; }
  .project-highlight strong { display: block; color: var(--color-accent); font-size: 1.25rem; }
  .project-highlight span { display: block; max-width: 8rem; margin-top: .25rem; color: var(--color-muted); font-size: .47rem; line-height: 1.4; }
  .project-open { color: var(--color-accent); font-size: .55rem; opacity: 0; transform: translateX(-.4rem); transition: opacity .25s ease, transform .25s ease; }
  .project-row:hover .project-open { opacity: 1; transform: translateX(0); }

  @media (max-width: 680px) {
    .project-row { grid-template-columns: 4rem 1fr; gap: 1rem; padding: .9rem; }
    .project-story { grid-template-columns: 1fr; }
    .project-side { grid-column: 2; align-self: auto; flex-direction: row; align-items: end; }
    .project-stamp { align-self: start; }
    .project-open { opacity: 1; }
  }
</style>
