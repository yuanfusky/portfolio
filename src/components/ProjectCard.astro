---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import ProjectIcon from './ProjectIcon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const { data } = project;
---

<article class="project-row group">
  <a class="project-hit" href={`/projects/${data.slug}/`} aria-label={`Read ${data.title}`}></a>
  <div class="project-stamp">
    <ProjectIcon slug={data.slug} code={data.projectCode} index={index} />
  </div>

  <div class="project-copy">
    <div class="mb-3 flex flex-wrap gap-2">
      <Tag label={data.status} />
      <Tag label={data.domain} />
    </div>
    <h3>{data.shortTitle}</h3>
    <div class="project-story">
      <div>
        <span>01 / Problem</span>
        <p>{data.problemSummary}</p>
      </div>
      <div>
        <span>02 / Methods & tools</span>
        <p>{data.methodsSummary}</p>
        <small>{data.tools.join(' · ')}</small>
      </div>
      <div>
        <span>03 / Outcome & goal</span>
        <p>{data.outcomeSummary}</p>
      </div>
    </div>
  </div>

  <div class="project-side">
    {data.highlightValue ? (
      <div class="project-highlight">
        <strong>{data.highlightValue}</strong>
        <span>{data.highlightLabel}</span>
      </div>
    ) : <span></span>}
    <span class="project-open">open study ↗</span>
  </div>
</article>

<style>
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: 5.75rem minmax(0, 1fr) 8.5rem;
    gap: 1.35rem;
    align-items: center;
    min-height: 12rem;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 1.15rem;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
  }
  .project-row:hover {
    z-index: 2;
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-ink) 22%, var(--color-line));
    box-shadow: 0 16px 36px rgba(52,54,56,.11);
  }
  .project-hit { position: absolute; inset: 0; z-index: 10; border-radius: inherit; }
  .project-stamp {
    align-self: start;
    padding: .65rem .55rem .5rem;
  }
  .project-copy h3 { color: var(--color-ink); font-size: clamp(1rem, 1.5vw, 1.18rem); font-weight: 600; letter-spacing: -.035em; }
  .project-story { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 1.25rem; max-width: 58rem; margin-top: .9rem; }
  .project-story > div { border-top: 1px solid var(--color-line); padding-top: .65rem; }
  .project-story span { display: inline-block; background: var(--color-accent); color: var(--color-ink); padding: .12rem .25rem; font-size: .56rem; letter-spacing: .08em; text-transform: uppercase; }
  .project-story p { margin-top: .35rem; color: var(--color-muted); font-size: .68rem; line-height: 1.7; }
  .project-story small { display: block; margin-top: .45rem; color: color-mix(in srgb, var(--color-muted) 76%, transparent); font-size: .54rem; line-height: 1.55; }
  .project-side { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; padding: .3rem; text-align: right; }
  .project-highlight strong { display: inline-block; background: var(--color-accent); color: var(--color-ink); padding-inline: .25rem; font-size: 1.25rem; }
  .project-highlight span { display: block; max-width: 8rem; margin-top: .25rem; color: var(--color-muted); font-size: .47rem; line-height: 1.4; }
  .project-open { color: var(--color-ink); font-size: .55rem; text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: .18rem; text-underline-offset: .2rem; opacity: 0; transform: translateX(-.4rem); transition: opacity .25s ease, transform .25s ease; }
  .project-row:hover .project-open { opacity: 1; transform: translateX(0); }

  @media (max-width: 900px) {
    .project-story { grid-template-columns: 1fr; }
  }

  @media (max-width: 680px) {
    .project-row { grid-template-columns: 4rem 1fr; gap: 1rem; padding: .9rem; }
    .project-side { grid-column: 2; align-self: auto; flex-direction: row; align-items: end; }
    .project-stamp { padding: .25rem .2rem; }
    .project-open { opacity: 1; }
  }
</style>
