---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;
const base = 'inline-flex items-center justify-center gap-3 border px-5 py-3 font-mono text-[0.64rem] font-medium uppercase tracking-[0.11em] transition duration-200';
const variants = {
  primary: 'border-accent bg-accent text-white shadow-[4px_4px_0_var(--color-ink)] hover:-translate-y-0.5 hover:shadow-[6px_6px_0_var(--color-ink)]',
  secondary: 'border-ink/30 bg-surface/50 text-ink hover:-translate-y-0.5 hover:border-accent hover:text-accent',
  text: 'border-transparent px-0 py-1 text-accent hover:text-ink',
};
---

<a class:list={[base, variants[variant]]} href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
  <slot />
  <span aria-hidden="true">↗</span>
</a>
