---
interface Props {
  index: string;
  title: string;
  intro?: string;
}
const { index, title, intro } = Astro.props;
---

<header class="mb-10 grid gap-4 md:mb-14 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.62fr)] md:items-end">
  <div>
    <p class="eyebrow mb-4">{index}</p>
    <h2 class="max-w-3xl text-3xl font-medium tracking-[-0.045em] text-ink sm:text-4xl lg:text-5xl">{title}</h2>
  </div>
  {intro && <p class="max-w-xl text-sm leading-7 text-muted md:justify-self-end">{intro}</p>}
</header>
