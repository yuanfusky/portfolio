---
interface Props {
  index: string;
  title: string;
  intro?: string;
}
const { index, title, intro } = Astro.props;
---

<header class="mb-12 grid gap-7 border-b border-ink/25 pb-9 md:mb-16 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.62fr)] md:items-end md:pb-11">
  <div>
    <p class="eyebrow mb-5">{index}</p>
    <h2 class="max-w-4xl font-serif text-4xl font-normal leading-[0.95] tracking-[-0.05em] text-ink sm:text-5xl lg:text-7xl">{title}<span class="text-accent">.</span></h2>
  </div>
  {intro && <p class="max-w-xl border-l border-ink/25 pl-5 text-sm leading-7 text-muted md:justify-self-end">{intro}</p>}
</header>
