---
import Button from './Button.astro';
---

<section class="hero-playground page-shell" aria-labelledby="hero-title">
  <div class="hero-intro">
    <p class="hero-kicker">Data Science and Information Engineering</p>
    <h1 id="hero-title" class="hero-name">
      <span class="hero-prompt" aria-hidden="true">&gt;</span>
      <span class="typing-track">
        <span class="hero-name-text">Jingyuan Ren</span>
        <span class="hero-cursor" aria-hidden="true"></span>
      </span>
    </h1>
    <p class="hero-role">Master's student at Linköping University</p>
    <p class="hero-tagline">Building reliable ML systems from complex real-world data.</p>
    <div class="hero-actions">
      <Button href="#work">View Work</Button>
      <Button href="/cv.pdf" variant="secondary">Download CV</Button>
    </div>
  </div>

  <div class="hero-keywords" aria-label="Areas of work">
    <span>Applied ML</span><span>GenAI Evaluation</span><span>Data Engineering</span><span>Sensor Data</span>
  </div>

  <a class="hero-scroll" href="#work-with">Scroll to explore <span>↓</span></a>
</section>

<style>
  .hero-playground {
    position: relative;
    isolation: isolate;
    min-height: min(780px, calc(100svh - 1rem));
    overflow: hidden;
  }

  .hero-intro {
    position: relative;
    z-index: 10;
    width: min(42rem, 72vw);
    margin: 0 auto;
    padding-top: clamp(10rem, 22vh, 13rem);
    text-align: center;
  }

  .hero-kicker,
  .hero-role,
  .hero-tagline,
  .hero-keywords,
  .hero-scroll { font-family: var(--font-mono); }

  .hero-kicker { margin-bottom: 1.4rem; color: var(--color-accent); font-size: .64rem; letter-spacing: .1em; }
  .hero-name { display: flex; align-items: baseline; justify-content: center; color: #343638; font-family: var(--font-mono); font-size: clamp(3rem, 7.6vw, 6.6rem); font-weight: 650; line-height: 1; letter-spacing: -.065em; text-shadow: .035em 0 color-mix(in srgb, var(--color-accent) 18%, transparent); }
  .hero-prompt { margin-right: .26em; color: var(--color-accent); font-size: .48em; font-weight: 500; text-shadow: none; }
  .typing-track { position: relative; display: inline-block; width: 12ch; margin-bottom: -.22em; padding-bottom: .22em; overflow: visible; text-align: left; white-space: nowrap; }
  .hero-name-text { display: block; clip-path: inset(0 100% -.24em 0); animation: type-name 1.35s steps(12, end) .28s forwards; }
  .hero-cursor { position: absolute; top: .08em; left: 0; width: .065em; height: .8em; background: var(--color-accent); box-shadow: 0 0 .16em color-mix(in srgb, var(--color-accent) 45%, transparent); animation: cursor-travel 1.35s steps(12, end) .28s forwards, cursor-blink .72s step-end 1.7s infinite; }
  @keyframes type-name { to { clip-path: inset(0 0 -.24em 0); } }
  @keyframes cursor-travel { to { transform: translateX(12ch); } }
  @keyframes cursor-blink { 50% { opacity: 0; } }
  .hero-role { margin-top: 1.25rem; color: var(--color-ink); font-size: clamp(.75rem, 1.2vw, 1rem); }
  .hero-tagline { max-width: 39rem; margin: 2.5rem auto 0; color: var(--color-ink); font-size: clamp(1rem, 1.55vw, 1.25rem); font-weight: 500; line-height: 1.5; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; margin-top: 1.5rem; }

  .hero-keywords { position: absolute; bottom: 4.25rem; left: 50%; z-index: 8; display: flex; transform: translateX(-50%); gap: .5rem; white-space: nowrap; }
  .hero-keywords span { border: 1px solid var(--color-line); border-radius: 99px; background: rgba(255,251,246,.74); padding: .45rem .7rem; color: var(--color-muted); font-size: .52rem; }
  .hero-scroll { position: absolute; bottom: 1.3rem; left: 50%; z-index: 8; transform: translateX(-50%); color: var(--color-muted); font-size: .55rem; text-decoration: none; }
  .hero-scroll span { color: var(--color-accent); }

  @media (max-width: 900px) {
    .hero-playground { min-height: auto; padding-bottom: 5rem; }
    .hero-intro { width: 100%; padding-top: 8rem; }
    .hero-keywords { position: relative; bottom: auto; left: auto; flex-wrap: wrap; justify-content: center; margin-top: 1.5rem; transform: none; white-space: normal; }
    .hero-scroll { display: none; }
  }

  @media (max-width: 540px) {
    .hero-intro { padding-top: 9rem; }
    .hero-name { font-size: clamp(2rem, 9vw, 2.5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-name-text { clip-path: none; animation: none; }
    .hero-cursor { transform: translateX(12ch); animation: none; }
  }
</style>
