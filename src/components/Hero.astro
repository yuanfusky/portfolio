---
import Button from './Button.astro';
---

<section class="page-shell relative overflow-hidden pb-24 pt-7 sm:pb-28 sm:pt-10 lg:min-h-[calc(100vh-4.5rem)]">
  <div class="relative border-y border-ink/25 px-1 py-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-muted">Technical folio / issue 01 / 2026</span>
      <div class="flex items-center gap-5 font-mono text-[0.58rem] uppercase tracking-[0.14em] text-muted">
        <span>Linköping / SE</span>
        <span class="hidden sm:inline">UTC+02</span>
        <span class="bg-accent px-2 py-1 text-white">Open to roles</span>
      </div>
    </div>
  </div>

  <div class="relative grid min-h-[34rem] gap-12 py-14 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(19rem,23rem)] lg:items-center lg:py-24">
    <div class="relative z-10">
      <p class="mb-7 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-muted">Jingyuan Ren / ML systems & evidence</p>
      <div aria-hidden="true" class="print-offset select-none font-serif text-[clamp(4.6rem,12.5vw,12.5rem)] leading-[0.68] tracking-[-0.085em] text-ink">
        Jingyuan<br /><span class="italic">Ren</span><span class="text-accent">.</span>
      </div>
      <p class="mt-12 max-w-2xl text-sm leading-6 text-muted sm:text-base">Data Science & Information Engineering Master's Student<br class="hidden sm:block" /> at Linköping University</p>
    </div>

    <aside class="group relative mx-auto w-full max-w-[19rem] sm:max-w-[22rem] lg:mx-0 lg:max-w-none" aria-label="Portrait of Jingyuan Ren">
      <div class="pointer-events-none absolute inset-0 border-2 border-accent opacity-0 transition duration-500 ease-out group-hover:translate-x-5 group-hover:translate-y-2 group-hover:opacity-100" aria-hidden="true"></div>
      <figure class="relative z-10">
        <img
          src="/jingyuan-zine-portrait.png"
          alt="Graphite sketch and paper collage portrait of Jingyuan Ren"
          width="720"
          height="720"
          loading="eager"
          fetchpriority="high"
          class="portrait-sketch block h-auto w-full"
        />
      </figure>
    </aside>
  </div>

  <div class="paper-surface grid border-y border-ink/25 lg:grid-cols-[minmax(0,1.25fr)_minmax(20rem,0.75fr)]">
    <div class="p-6 sm:p-9 lg:p-12">
      <p class="eyebrow mb-7">Primary inquiry</p>
      <h1 class="zine-rule max-w-4xl pb-7 font-serif text-[clamp(2.5rem,5.2vw,5.5rem)] font-normal leading-[0.93] tracking-[-0.055em] text-ink">Building reliable ML systems from complex real-world data.</h1>
    </div>
    <aside class="border-t border-ink/20 p-6 sm:p-9 lg:border-l lg:border-t-0 lg:p-12">
      <p class="max-w-md text-base leading-7 text-muted">I care about models that are not only accurate, but also testable, explainable, and clearly communicated.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <Button href="#work">View Work</Button>
        <Button href="/cv.pdf" variant="secondary">Download CV</Button>
      </div>
      <div class="mt-10 border-t border-ink/20 pt-5">
        <p class="font-mono text-[0.62rem] leading-6 tracking-[0.08em] text-muted">APPLIED ML / GENAI EVALUATION / DATA ENGINEERING / SENSOR DATA / SIGNAL PROCESSING</p>
      </div>
    </aside>
  </div>

  <div class="mt-6 grid grid-cols-[auto_1fr_auto_1fr_auto] items-center gap-4 font-mono text-[0.56rem] uppercase tracking-[0.16em] text-muted">
    <span>Input</span><span class="h-px bg-line"></span><span class="text-accent">Model + Evaluate</span><span class="h-px bg-line"></span><span>Explain</span>
  </div>
</section>

<style>
  .portrait-sketch {
    -webkit-mask-image: radial-gradient(ellipse 78% 88% at 50% 48%, #000 62%, rgba(0, 0, 0, 0.92) 72%, transparent 100%);
    mask-image: radial-gradient(ellipse 78% 88% at 50% 48%, #000 62%, rgba(0, 0, 0, 0.92) 72%, transparent 100%);
    mix-blend-mode: multiply;
  }
</style>
