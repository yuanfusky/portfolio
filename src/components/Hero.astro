---
import Button from './Button.astro';
---

<section class="page-shell relative overflow-hidden pb-20 pt-8 sm:pb-24 sm:pt-12 lg:min-h-[calc(100vh-4.5rem)]">
  <div class="corner-frame relative border-y border-line px-4 py-5 sm:px-7">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="system-chip">System profile / 2026</span>
      <div class="flex items-center gap-5 font-mono text-[0.58rem] uppercase tracking-[0.14em] text-muted">
        <span>Linköping / SE</span>
        <span class="hidden sm:inline">UTC+02</span>
        <span class="text-accent">Open to roles</span>
      </div>
    </div>
  </div>

  <div class="relative py-12 sm:py-16 lg:py-20">
    <div class="tech-grid absolute inset-y-8 right-0 hidden w-[42%] opacity-60 lg:block"></div>
    <div class="absolute right-[8%] top-[14%] hidden size-44 rounded-full border border-dashed border-accent/25 lg:block"></div>
    <div class="absolute right-[13%] top-[25%] hidden size-24 rounded-full bg-accent/8 blur-2xl lg:block"></div>

    <div class="relative z-10">
      <p class="eyebrow mb-5">Jingyuan Ren / Portfolio</p>
      <div aria-hidden="true" class="select-none text-[clamp(4.5rem,13.2vw,13.6rem)] font-black uppercase leading-[0.72] tracking-[-0.09em] text-ink">
        Jingyuan<span class="text-accent">.</span><br />Ren
      </div>
      <p class="mt-10 max-w-2xl border-l-2 border-accent pl-5 text-sm font-medium leading-6 text-muted sm:text-base">Data Science & Information Engineering Master's Student at Linköping University</p>
    </div>
  </div>

  <div class="grid border-y border-line bg-surface/70 lg:grid-cols-[minmax(0,1.2fr)_minmax(20rem,0.8fr)]">
    <div class="p-6 sm:p-8 lg:p-10">
      <p class="eyebrow mb-6">Primary objective</p>
      <h1 class="max-w-4xl text-[clamp(2.25rem,5vw,5.25rem)] font-bold leading-[0.95] tracking-[-0.065em] text-ink">Building reliable ML systems from complex real-world data.</h1>
    </div>
    <aside class="border-t border-line p-6 sm:p-8 lg:border-l lg:border-t-0 lg:p-10">
      <p class="max-w-md text-base leading-7 text-muted">I care about models that are not only accurate, but also testable, explainable, and clearly communicated.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <Button href="#work">View Work</Button>
        <Button href="/cv.pdf" variant="secondary">Download CV</Button>
      </div>
      <div class="mt-10 border-t border-line pt-5">
        <p class="font-mono text-[0.62rem] leading-6 tracking-[0.08em] text-muted">APPLIED ML / GENAI EVALUATION / DATA ENGINEERING / SENSOR DATA / SIGNAL PROCESSING</p>
      </div>
    </aside>
  </div>

  <div class="mt-5 grid grid-cols-[auto_1fr_auto_1fr_auto] items-center gap-4 font-mono text-[0.58rem] uppercase tracking-[0.14em] text-muted">
    <span>Input</span><span class="h-px bg-line"></span><span class="text-accent">Model + Evaluate</span><span class="h-px bg-line"></span><span>Explain</span>
  </div>
</section>
