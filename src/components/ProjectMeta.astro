---
interface Props {
  dataType: string;
  methods: string[];
  tools: string[];
}
const { dataType, methods, tools } = Astro.props;
---

<dl class="grid gap-5 text-xs sm:grid-cols-3">
  <div><dt class="eyebrow mb-2">Data</dt><dd class="leading-5 text-muted">{dataType}</dd></div>
  <div><dt class="eyebrow mb-2">Methods</dt><dd class="leading-5 text-muted">{methods.slice(0, 3).join(' · ')}</dd></div>
  <div><dt class="eyebrow mb-2">Tools</dt><dd class="leading-5 text-muted">{tools.join(' · ')}</dd></div>
</dl>
