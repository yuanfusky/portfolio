---
interface Props {
  number: string;
  title: string;
  items: string[];
}
const { number, title, items } = Astro.props;
---

<article class="group relative min-h-72 overflow-hidden border border-line bg-surface/60 p-6 transition duration-300 hover:-translate-y-1 hover:border-accent sm:p-7">
  <div class="tech-grid absolute inset-0 opacity-0 transition duration-300 group-hover:opacity-100"></div>
  <div class="flex items-center justify-between">
    <span class="relative z-10 font-mono text-[0.65rem] tracking-widest text-accent">{number} / DATA</span>
    <span class="relative z-10 size-2 rounded-full border border-accent transition group-hover:bg-accent group-hover:shadow-[0_0_0_6px_rgba(22,78,232,0.1)]"></span>
  </div>
  <div class="absolute right-4 top-10 font-mono text-7xl font-bold tracking-[-0.08em] text-ink/[0.035] transition group-hover:text-accent/[0.08]">{number}</div>
  <h3 class="relative z-10 mt-14 max-w-[12rem] text-2xl font-bold leading-tight tracking-[-0.045em] transition group-hover:text-accent">{title}</h3>
  <ul class="relative z-10 mt-7 space-y-2 border-t border-line pt-5 text-sm leading-6 text-muted">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</article>
