---
interface Props {
  number: string;
  title: string;
  items: string[];
}
const { number, title, items } = Astro.props;
---

<article class="group min-h-64 border border-line bg-surface/60 p-6 transition duration-300 hover:-translate-y-1 hover:border-accent/50 hover:bg-surface sm:p-7">
  <div class="flex items-center justify-between">
    <span class="font-mono text-[0.65rem] tracking-widest text-muted">{number}</span>
    <span class="size-2 rounded-full border border-accent transition group-hover:bg-accent"></span>
  </div>
  <h3 class="mt-12 text-xl font-medium tracking-[-0.035em]">{title}</h3>
  <ul class="mt-7 space-y-2 border-t border-line pt-5 text-sm leading-6 text-muted">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</article>
