---
interface Props {
  number: string;
  title: string;
  items: string[];
}
const { number, title, items } = Astro.props;
---

<article class="group relative min-h-64 overflow-hidden rounded-2xl border border-line bg-surface/60 p-6 transition duration-300 hover:-translate-y-1 hover:border-ink/20 hover:bg-surface hover:shadow-[0_14px_34px_rgba(52,54,56,.10)] sm:p-7">
  <div class="flex items-center justify-between">
    <span class="relative z-10 bg-accent px-1.5 py-0.5 font-mono text-[0.58rem] text-ink">{number} / data</span>
    <span class="relative z-10 size-2 rounded-full bg-accent transition group-hover:scale-[2]"></span>
  </div>
  <div class="absolute -right-3 top-10 font-mono text-7xl font-semibold text-ink/[0.035] transition group-hover:text-accent/[0.08]">{number}</div>
  <h3 class="relative z-10 mt-12 max-w-[13rem] font-mono text-lg font-semibold leading-tight tracking-[-0.035em] decoration-accent decoration-4 underline-offset-4 transition group-hover:underline">{title}</h3>
  <ul class="relative z-10 mt-7 space-y-2 border-t border-line pt-5 text-sm leading-6 text-muted">
    {items.map((item) => <li class="text-xs">{item}</li>)}
  </ul>
</article>
