---
interface Props {
  number: string;
  title: string;
  items: string[];
}
const { number, title, items } = Astro.props;
---

<article class="paper-surface group relative min-h-72 overflow-hidden border border-ink/20 p-6 transition duration-300 hover:-translate-y-1 hover:border-accent sm:p-7">
  <div class="flex items-center justify-between">
    <span class="relative z-10 font-mono text-[0.65rem] tracking-widest text-accent">{number} / DATA</span>
    <span class="relative z-10 size-2 border border-accent transition group-hover:rotate-45 group-hover:bg-accent"></span>
  </div>
  <div class="archive-number absolute right-4 top-12 transition group-hover:text-accent/15">{number}</div>
  <h3 class="relative z-10 mt-14 max-w-[13rem] font-serif text-3xl leading-[1.02] tracking-[-0.045em] transition group-hover:text-accent">{title}</h3>
  <ul class="relative z-10 mt-7 space-y-2 border-t border-line pt-5 text-sm leading-6 text-muted">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</article>
