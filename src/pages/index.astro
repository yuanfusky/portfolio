---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import WorkWithCard from '../components/WorkWithCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ThinkingCard from '../components/ThinkingCard.astro';
import EducationItem from '../components/EducationItem.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import VisualNotesGrid from '../components/VisualNotesGrid.astro';
import Button from '../components/Button.astro';

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.priority - b.data.priority);

const workAreas = [
  { title: 'Text Data', items: ['RAG evaluation', 'Retrieval quality', 'Grounded generation'] },
  { title: 'Medical Data', items: ['Synthetic tabular data', 'Privacy–utility tradeoff', 'Semantic preservation'] },
  { title: 'Sensor Data', items: ['Measurement noise', 'Sensor fusion', 'State estimation'] },
  { title: 'Spatiotemporal / Structured Data', items: ['Forecasting', 'Model selection', 'Evaluation design'] },
];

const thinking = [
  { title: 'Model uncertainty', text: 'Working with noisy measurements, probabilistic models, Bayesian learning, and sensor fusion.' },
  { title: 'Evaluate systems', text: 'Designing evaluations for RAG, ML models, synthetic data, and retrieval quality.' },
  { title: 'Build workflows', text: 'Creating reproducible pipelines for preprocessing, modelling, validation, and reporting.' },
  { title: 'Communicate clearly', text: 'Explaining complex technical systems through structured writing, visual design, and data storytelling.' },
];
---

<BaseLayout>
  <Hero />

  <section class="section-block bg-paper" id="work-with">
    <div class="page-shell">
      <SectionTitle index="01 / Inputs" title="What I Work With" intro="Different data types create different failure modes. I focus on understanding those constraints before choosing a model." />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4">
        {workAreas.map((area, index) => <WorkWithCard number={String(index + 1).padStart(2, '0')} {...area} />)}
      </div>
    </div>
  </section>

  <section class="section-block bg-surface/50" id="work">
    <div class="page-shell">
      <SectionTitle index="02 / Systems" title="Selected ML & Data Systems Work" intro="Academic, competition, and research-oriented work—presented as it is today, with a clear path toward deeper case studies." />
      <div class="border-t border-line">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <div class="mt-8 flex justify-end"><Button href="/projects" variant="secondary">View all projects</Button></div>
    </div>
  </section>

  <section class="section-block" id="approach">
    <div class="page-shell">
      <SectionTitle index="03 / Approach" title="How I Think" intro="A practical loop for technical work: understand uncertainty, build the workflow, evaluate the system, and communicate the result." />
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {thinking.map((item, index) => <ThinkingCard {...item} index={String(index + 1).padStart(2, '0')} />)}
      </div>
    </div>
  </section>

  <section class="section-block bg-surface/50" id="background">
    <div class="page-shell">
      <SectionTitle index="04 / Background" title="Education & Experience" intro="A technical path grounded in information engineering, expanded through data science, and sharpened by communication practice." />
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
        <div>
          <EducationItem school="Linköping University" degree="MSc, Data Science and Information Engineering" location="Linköping, Sweden" date="Expected 2027" detail="Relevant coursework: Machine Learning, Bayesian Learning, Sensor Fusion, Detection & Estimation of Signals, Multidimensional Signal Analysis, NLP, and Data Mining." />
          <EducationItem school="Jiangsu University" degree="BEng, Electronic Information Science and Technology" location="Jiangsu, China" date="2015–2019" detail="Focus: signal processing, measurement systems, and communications engineering." thesis="Digital Watermarking for Speech Signals in MATLAB, including robustness analysis under noise and compression attacks." />
          <EducationItem school="Communication University of China" degree="Master's, TV / Media Production" location="Beijing, China" date="2019–2022" detail="Focus: communication, documentary storytelling, visual research, and research-based narrative structure." />
        </div>
        <div class="lg:pt-10">
          <div class="sticky top-24 border border-line bg-paper p-7">
            <p class="eyebrow">Through-line</p>
            <p class="mt-5 text-2xl leading-snug tracking-[-0.04em]">From signals to systems—and from systems to explanations people can use.</p>
            <div class="mt-10 space-y-4 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted">
              <div class="flex justify-between border-t border-line pt-3"><span>Engineering</span><span>01</span></div>
              <div class="flex justify-between border-t border-line pt-3"><span>Data science</span><span>02</span></div>
              <div class="flex justify-between border-t border-line pt-3"><span>Communication</span><span>03</span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-16">
        <ExperienceItem company="ByteDance / TikTok" role="Content Operations Intern, Documentary Studio" summary="Worked with documentary content operations in a large-scale digital platform environment, using dashboard tracking, A/B testing, content tagging, and competitive analysis to understand retention patterns and content performance." bullets={[
          'Built dashboards tracking play count, completion rate, and drop-off points to surface retention patterns beyond raw views.',
          'Designed title and thumbnail A/B tests with significance testing, accounting for algorithmic traffic allocation.',
          'Developed a genre, region, and tone tagging framework and analyzed relationships with recommendation performance.',
          'Studied comparable accounts to identify content gaps and demand trends in the documentary vertical.',
        ]} />
      </div>
    </div>
  </section>

  <section class="section-block" id="visual-notes">
    <div class="page-shell">
      <SectionTitle index="05 / Secondary lens" title="Visual Notes" intro="Before data science, I trained in communication and documentary storytelling. That background still shapes how I approach technical work: I care about structure, clarity, and how complex information is perceived." />
      <VisualNotesGrid />
      <div class="mt-8 flex flex-wrap gap-5"><Button href="#" variant="text">Selected visual work</Button><Button href="#" variant="text">Writing & visual notes</Button></div>
    </div>
  </section>

  <section class="relative overflow-hidden border-t border-ink bg-surface" id="contact">
    <div class="tech-grid absolute inset-0 opacity-70"></div>
    <div class="page-shell relative z-10 py-20 sm:py-28">
      <div class="mb-8 flex items-center justify-between border-b border-ink pb-5">
        <p class="eyebrow">06 / Contact</p>
        <span class="system-chip">Available for MLE / AI / Data roles</span>
      </div>
      <h2 class="max-w-7xl text-[clamp(3.6rem,10vw,10rem)] font-black uppercase leading-[0.76] tracking-[-0.085em] text-ink">Let's build<br />reliable systems<span class="text-accent">.</span></h2>
      <div class="mt-14 grid gap-8 border-t border-line pt-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <p class="max-w-2xl text-base leading-7 text-muted">I’m preparing for MLE, AI Engineer, and Data Engineer roles. I’d be glad to discuss the work, the methods, or what I’m building next.</p>
        <div class="flex flex-wrap gap-3">
          <Button href="mailto:hello@example.com">Email me</Button>
          <Button href="https://github.com/" variant="secondary" external>GitHub</Button>
          <Button href="https://www.linkedin.com/" variant="secondary" external>LinkedIn</Button>
          <Button href="/cv.pdf" variant="secondary">CV PDF</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
