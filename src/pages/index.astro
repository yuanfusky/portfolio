---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import WorkWithCard from '../components/WorkWithCard.astro';
import StudyList from '../components/StudyList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EducationItem from '../components/EducationItem.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import VisualNotesTeaser from '../components/VisualNotesTeaser.astro';
import Button from '../components/Button.astro';

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.priority - b.data.priority);

const workAreas = [
  { title: 'LLM / AI Data', items: ['RAG evaluation', 'Retrieval quality', 'Grounded generation'] },
  { title: 'Sensor Data', items: ['Measurement noise', 'Sensor fusion', 'State estimation'] },
  { title: 'Fault Diagnosis', items: ['Normal-behaviour modelling', 'Residual change detection', 'OOD & false-alarm control'] },
  { title: 'Synthetic Medical Data', items: ['Privacy–utility tradeoff', 'Semantic preservation', 'Schema validation'] },
];

const courses = [
  'Machine Learning',
  'Advanced Machine Learning',
  'Distributed Information Processing and Machine Learning',
  'Information Networks',
  'Bayesian Learning',
  'Sensor Fusion',
  'Detection & Estimation of Signals',
  'Multidimensional Signal Analysis',
  'Natural Language Processing',
  'Data Mining',
];

---

<BaseLayout>
  <Hero />

  <section class="section-block bg-paper" id="work-with">
    <div class="page-shell">
      <SectionTitle index="01 / Inputs" title="What I Work With" intro="Different data types create different failure modes. I focus on understanding those constraints before choosing a model." />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {workAreas.map((area, index) => <WorkWithCard number={String(index + 1).padStart(2, '0')} {...area} />)}
      </div>
    </div>
  </section>

  <section class="section-block study-section" id="study-with">
    <div class="page-shell">
      <SectionTitle index="02 / Foundations" title="What I Study With" intro="Coursework spanning machine learning, distributed systems, probabilistic reasoning, signal estimation, and information networks." />
      <StudyList courses={courses} />
    </div>
  </section>

  <section class="section-block" id="work">
    <div class="page-shell">
      <SectionTitle index="03 / Systems" title="Selected ML & Data Systems Work" />
      <div class="space-y-3">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <div class="mt-8 flex justify-end"><Button href="/projects" variant="secondary">View all projects</Button></div>
    </div>
  </section>

  <section class="section-block" id="background">
    <div class="page-shell">
      <SectionTitle index="04 / Background" title="Education & Experience" intro="A technical path grounded in information engineering, expanded through data science, and sharpened by communication practice." />
      <div>
        <ExperienceItem company="Linköping University" role="Machine Learning Teaching Assistant · 2026–Present" summary="Supporting Machine Learning teaching through hands-on guidance, assessment, and discussion-based learning." bullets={[
          'Guide students during laboratory sessions and help them reason through implementation and model-evaluation problems.',
          'Grade assignments and provide structured feedback on technical work.',
          'Lead seminar sessions that connect machine learning concepts with exercises and discussion.',
        ]} />
      </div>

      <div class="mt-5">
        <ExperienceItem company="ByteDance / TikTok" role="Content Operations Intern, Documentary Studio" summary="Worked with documentary content operations in a large-scale digital platform environment, using dashboard tracking, A/B testing, content tagging, and competitive analysis to understand retention patterns and content performance." bullets={[
          'Built dashboards tracking play count, completion rate, and drop-off points to surface retention patterns beyond raw views.',
          'Designed title and thumbnail A/B tests with significance testing, accounting for algorithmic traffic allocation.',
          'Developed a genre, region, and tone tagging framework and analyzed relationships with recommendation performance.',
          'Studied comparable accounts to identify content gaps and demand trends in the documentary vertical.',
        ]} />
      </div>

      <div class="mt-16 max-w-4xl">
        <EducationItem school="Linköping University" degree="MSc, Data Science and Information Engineering" location="Linköping, Sweden" date="Expected 2027" detail="Relevant coursework: Machine Learning, Bayesian Learning, Sensor Fusion, Detection & Estimation of Signals, Multidimensional Signal Analysis, NLP, and Data Mining." />
        <EducationItem school="Jiangsu University" degree="BEng, Electronic Information Science and Technology" location="Jiangsu, China" date="2015–2019" detail="Focus: signal processing, measurement systems, and communications engineering." thesis="Digital Watermarking for Speech Signals in MATLAB, including robustness analysis under noise and compression attacks." />
        <EducationItem school="Communication University of China" degree="Master's, TV / Media Production" location="Beijing, China" date="2019–2022" detail="Focus: communication, documentary storytelling, visual research, and research-based narrative structure." />
      </div>
    </div>
  </section>

  <section class="section-block" id="visual-notes">
    <div class="page-shell">
      <VisualNotesTeaser />
    </div>
  </section>

</BaseLayout>

<style>
  .study-section {
    background: color-mix(in srgb, var(--color-surface) 72%, var(--color-paper));
  }
</style>
